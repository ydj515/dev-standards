# Match this value to requires-python and the Python version in mise.toml.
target-version = "py312"
line-length = 100
indent-width = 4

[lint]
select = ["E4", "E7", "E9", "F", "I", "B", "D", "UP", "RUF"]

[lint.pydocstyle]
convention = "google"

[format]
quote-style = "double"
indent-style = "space"
line-ending = "lf"
docstring-code-format = true
