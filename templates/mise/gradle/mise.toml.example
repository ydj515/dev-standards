# Replace every REPLACE_ME value with a version verified by the consuming project.

min_version = "REPLACE_ME"

[tools]
java = "temurin-REPLACE_ME"

[env]
APP_ENV = "local"

[settings]
lockfile = true

[tasks.lint]
run = "./gradlew check -x test"

[tasks.test]
run = "./gradlew test"

[tasks.verify]
alias = "ci"
run = "./gradlew check"
