plugins {
    alias(libs.plugins.spotless)
}

spotless {
    java {
        // Choose one formatter and pin its version in the consuming build.
        googleJavaFormat(libs.versions.google.java.format.get())
        target("src/**/*.java")
    }
    kotlin {
        // Add this block only when Kotlin source is in the module.
        ktlint(libs.versions.ktlint.get())
        target("src/**/*.kt")
    }
}

tasks.named("check") {
    dependsOn("spotlessCheck")
}
